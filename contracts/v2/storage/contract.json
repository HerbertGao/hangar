{
  "schemaVersion": "v2-storage-contract-v1",
  "requirementIds": ["v2s.sqlite", "v2s.ddl"],
  "databaseFile": "independent-v2-sqlite",
  "foreignKeysRequired": true,
  "authoritativeTables": [
    "storage_identity",
    "control_instance_ids",
    "control_instances",
    "source_facts",
    "authenticated_evidence",
    "authenticated_evidence_consumptions",
    "evidence_authority_heads",
    "agents",
    "agent_releases",
    "activations",
    "runs",
    "run_events",
    "run_attempts",
    "attempt_quiescence",
    "actions",
    "action_events",
    "checkpoints",
    "checkpoint_obligations",
    "obligation_owner_transfers",
    "effects",
    "approvals",
    "effect_claims",
    "effect_dispatches",
    "external_receipts",
    "external_outcomes",
    "commands",
    "recovery_sessions",
    "recovery_qualifications",
    "recovery_agent_attempts",
    "recovery_discovered_operations",
    "recovery_operation_memberships",
    "recovery_artifacts",
    "binding_certificates",
    "activation_permit_evidence",
    "recovery_conflict_heads",
    "binding_conflict_evidence",
    "mutation_authorities",
    "registration_closures",
    "target_authority_closures"
  ],
  "supportTables": [
    "source_fact_kinds",
    "launch_attestations",
    "process_ownership",
    "schedule_series",
    "release_schedule_series",
    "schedule_occurrences"
  ],
  "disposableProjectionTables": ["run_projection", "action_projection"],
  "forbiddenLegacyTables": ["App", "RunEvent-v0", "Approval-v0"],
  "identityRules": {
    "databaseIdentityAcrossRestore": "preserve",
    "controlInstanceAcrossClone": "never-reuse",
    "controlInstanceNamespace": "global-proposed-active-historical",
    "runAliasWithV0": false,
    "effectLogicalIdentity": ["runId", "intentKey", "intentGeneration"],
    "recoveryOperationIdentity": ["databaseIdentity", "actualControlInstanceId", "sink", "discoveryKey"]
  },
  "cleanRestart": {
    "exclusiveContinuationProofRequired": true,
    "currentBootAndStartupCycleRequired": true,
    "currentTimeEvidenceRequired": true,
    "currentProductionControlGenerationRequired": true,
    "singleUse": true,
    "resumeFactAtomic": true
  },
  "recovery": {
    "databaseLevelSession": true,
    "singleTargetPerFile": true,
    "perAgentQualification": true,
    "sharedTargetIndependentEpochs": true,
    "proposedIdNeverReused": true
  },
  "schedule": {
    "identityOnly": true,
    "cursorTable": false,
    "admissionInM0M1": "unsupported_schedule"
  }
}
