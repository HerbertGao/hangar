<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  hangar 脊柱 daemon 的 launchd agent(ts.mac-mini)。装到 ~/Library/LaunchAgents/。
  路径按 home=/Users/herbertgao、repo=~/hangar、pilot=~/inbox-pilot-hangar 写死。

  这份取代了原先的 `~/hangar-inbox-daemon.sh` wrapper。wrapper 的唯一职责是
  `set -a; . <pilot>/.env; set +a` —— 因为 daemon 的 cwd 是 ~/hangar 而 pilot 在别处,
  pilot 自己的 `import 'dotenv/config'` 默认只看 cwd,找不到那份 .env。改由下面的
  DOTENV_CONFIG_PATH 显式指路,该职责消失,shell 那一层就不必存在了。

  **密钥不进这个文件。** EnvironmentVariables 里只有非密钥变量;所有密钥留在
  DOTENV_CONFIG_PATH 指向的那一份 .env 里(它同时还服务 pilot 自己的入口:
  prisma migrate deploy / account / eval:*)。同一个密钥值出现在两个文件 = 迟早漂移。

  node 路径钉死到具体版本:launchd 不经 shell,拿不到 fnm 的 PATH 注入。
  换 node major 后这一行要跟着改(且原生模块要 `pnpm rebuild -r`)。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.herbertgao.hangar-inbox</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/herbertgao/.local/share/fnm/node-versions/v24.18.0/installation/bin/node</string>
    <string>/Users/herbertgao/hangar/packages/core/dist/cli.js</string>
    <string>daemon</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>

    <key>HANGAR_APPS</key>
    <string>/Users/herbertgao/hangar/apps</string>

    <!-- pilot 的 `import 'dotenv/config'` 据此找到 .env(密钥的唯一落点)。 -->
    <key>DOTENV_CONFIG_PATH</key>
    <string>/Users/herbertgao/inbox-pilot-hangar/.env</string>

    <!-- 显式声明,不靠约定默认:preflight 据此确保自己读的就是 daemon 会读的那份。 -->
    <key>HANGAR_NOTIFY_CONFIG</key>
    <string>/Users/herbertgao/.config/hangar/channels.yaml</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>WorkingDirectory</key>
  <string>/Users/herbertgao/hangar</string>

  <key>StandardOutPath</key>
  <string>/Users/herbertgao/hangar-inbox.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/herbertgao/hangar-inbox.err.log</string>
</dict>
</plist>
