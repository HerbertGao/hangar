{
  "openapi": "3.1.0",
  "info": {
    "title": "Hangar Control API",
    "version": "control-routes-v1"
  },
  "paths": {
    "/v1/agents": {
      "get": {
        "operationId": "agents.list",
        "security": [
          {
            "controlCredential": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "agents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "agentId": {
                            "type": "string"
                          },
                          "releaseCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "agentId",
                          "releaseCount"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "agents"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Typed error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "schemaVersion",
                        "kind",
                        "message"
                      ],
                      "properties": {
                        "schemaVersion": {
                          "const": "wire-error-v1"
                        },
                        "kind": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/agents/{agentId}/releases": {
      "get": {
        "operationId": "releases.list",
        "security": [
          {
            "controlCredential": []
          }
        ],
        "parameters": [
          {
            "name": "agentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "releases": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "agentId": {
                            "type": "string"
                          },
                          "releaseId": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "schemaVersion": {
                            "type": "string",
                            "enum": [
                              "agent-release-v1",
                              "agent-release-v2"
                            ]
                          },
                          "intentDescriptors": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "intentId": {
                                  "type": "string"
                                },
                                "descriptorVersion": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "inputSchema": {
                                  "type": "object",
                                  "properties": {
                                    "id": {
                                      "type": "string"
                                    },
                                    "version": {
                                      "type": "string"
                                    },
                                    "digest": {
                                      "type": "string",
                                      "pattern": "^[0-9a-f]{64}$"
                                    }
                                  },
                                  "required": [
                                    "id",
                                    "version",
                                    "digest"
                                  ],
                                  "additionalProperties": false
                                },
                                "scope": {
                                  "type": "string"
                                },
                                "policyId": {
                                  "type": "string"
                                },
                                "resultSchema": {
                                  "type": "object",
                                  "properties": {
                                    "id": {
                                      "type": "string"
                                    },
                                    "version": {
                                      "type": "string"
                                    },
                                    "digest": {
                                      "type": "string",
                                      "pattern": "^[0-9a-f]{64}$"
                                    }
                                  },
                                  "required": [
                                    "id",
                                    "version",
                                    "digest"
                                  ],
                                  "additionalProperties": false
                                }
                              },
                              "required": [
                                "intentId",
                                "descriptorVersion",
                                "inputSchema",
                                "scope",
                                "policyId",
                                "resultSchema"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "etag": {
                            "type": "string",
                            "pattern": "^\"[0-9a-f]{64}\"$"
                          }
                        },
                        "required": [
                          "agentId",
                          "releaseId",
                          "schemaVersion",
                          "intentDescriptors",
                          "etag"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "releases"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Typed error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "schemaVersion",
                        "kind",
                        "message"
                      ],
                      "properties": {
                        "schemaVersion": {
                          "const": "wire-error-v1"
                        },
                        "kind": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/agents/{agentId}/intents/{intent}": {
      "post": {
        "operationId": "intent.submit",
        "security": [
          {
            "controlCredential": []
          }
        ],
        "parameters": [
          {
            "name": "agentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "intent",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "runId": {
                      "type": "string"
                    },
                    "result": {
                      "type": "object",
                      "properties": {
                        "runId": {
                          "type": "string"
                        },
                        "releaseId": {
                          "type": "string"
                        },
                        "activationEpoch": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "executionMode": {
                          "type": "string",
                          "enum": [
                            "shadow-evaluator",
                            "production"
                          ]
                        },
                        "inputDigest": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "promptDigest": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      },
                      "required": [
                        "runId",
                        "releaseId",
                        "activationEpoch",
                        "executionMode",
                        "inputDigest",
                        "promptDigest"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "runId",
                    "result"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Typed error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "schemaVersion",
                        "kind",
                        "message"
                      ],
                      "properties": {
                        "schemaVersion": {
                          "const": "wire-error-v1"
                        },
                        "kind": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "descriptorVersion": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "executionMode": {
                    "type": "string",
                    "enum": [
                      "shadow-evaluator",
                      "production"
                    ]
                  },
                  "input": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "descriptorVersion",
                  "executionMode",
                  "input"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/runs/{runId}": {
      "get": {
        "operationId": "runs.read",
        "security": [
          {
            "controlCredential": []
          }
        ],
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "run": {
                      "type": "object",
                      "properties": {
                        "runId": {
                          "type": "string"
                        },
                        "agentId": {
                          "type": "string"
                        },
                        "releaseId": {
                          "type": "string"
                        },
                        "activationEpoch": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "state": {
                          "type": "string",
                          "enum": [
                            "running",
                            "waiting",
                            "cancel-requested",
                            "cancel-pending-reconciliation",
                            "completed",
                            "failed",
                            "cancelled"
                          ]
                        },
                        "currentAttempt": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "attemptState": {
                          "type": "string",
                          "enum": [
                            "running",
                            "checkpointed",
                            "succeeded",
                            "failed",
                            "cancelled"
                          ]
                        },
                        "executionMode": {
                          "type": "string",
                          "enum": [
                            "shadow-evaluator",
                            "production"
                          ]
                        },
                        "checkpointId": {
                          "type": "string"
                        },
                        "outcomeArtifactDigest": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "runId",
                        "agentId",
                        "releaseId",
                        "activationEpoch",
                        "state",
                        "currentAttempt",
                        "attemptState"
                      ],
                      "additionalProperties": false
                    },
                    "pendingApprovals": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "approvalId": {
                            "type": "string"
                          },
                          "runId": {
                            "type": "string"
                          },
                          "state": {
                            "type": "string",
                            "const": "pending"
                          },
                          "operation": {
                            "type": "string"
                          },
                          "expiresAtUnixMs": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "approvalId",
                          "runId",
                          "state",
                          "operation"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "run",
                    "pendingApprovals"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Typed error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "schemaVersion",
                        "kind",
                        "message"
                      ],
                      "properties": {
                        "schemaVersion": {
                          "const": "wire-error-v1"
                        },
                        "kind": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{runId}/events": {
      "get": {
        "operationId": "runs.events",
        "security": [
          {
            "controlCredential": []
          }
        ],
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
