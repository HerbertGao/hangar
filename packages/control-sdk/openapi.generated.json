              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Typed error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "schemaVersion",
                        "kind",
                        "message"
                      ],
                      "properties": {
                        "schemaVersion": {
                          "const": "wire-error-v1"
                        },
                        "kind": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{runId}/cancel": {
      "post": {
        "operationId": "runs.cancel",
        "security": [
          {
            "controlCredential": []
          }
        ],
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "runId": {
                      "type": "string"
                    },
                    "cancelStatus": {
                      "type": "string",
                      "enum": [
                        "cleanup-pending",
                        "cancel-pending-reconciliation"
                      ]
                    },
                    "result": {
                      "type": "object",
                      "properties": {
                        "runId": {
                          "type": "string"
                        },
                        "cancelStatus": {
                          "type": "string",
                          "enum": [
                            "cleanup-pending",
                            "cancel-pending-reconciliation"
                          ]
                        },
                        "fenceGeneration": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "runId",
                        "cancelStatus",
                        "fenceGeneration"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "runId",
                    "cancelStatus",
                    "result"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Typed error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "schemaVersion",
                        "kind",
                        "message"
                      ],
                      "properties": {
                        "schemaVersion": {
                          "const": "wire-error-v1"
                        },
                        "kind": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "reasonCode": {
                    "type": "string",
                    "const": "user-requested"
                  }
                },
                "required": [
                  "reasonCode"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/approvals/{approvalId}/decision": {
      "post": {
        "operationId": "approvals.decide",
        "security": [
          {
            "controlCredential": []
          }
        ],
        "parameters": [
