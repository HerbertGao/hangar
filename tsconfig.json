{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "types/**/*.d.ts",
    "packages/**/*.ts",
    "apps/**/*.ts",
    "tests/**/*.ts"
  ]
}
